{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "top-pad-api",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-20",
  // global_fetch_strictly_public: on devnet the API fetches the X stand-in, another Worker on the same workers.dev zone,
  // which fails with error 1042 unless fetch() routes as if from the public internet.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },
  // Every five minutes: the indexer woken if a deploy stopped it, the keeper's float against its floor, the quotes' band, housekeeping,
  // then any open alert to the operator. Every minute: Vamp Shield's protected set (spec 6.2), and at minute 2 of each
  // hour its hourly lists and the images not yet signed.
  "triggers": { "crons": ["*/5 * * * *", "* * * * *"] },
  // The indexer, the live rooms and the vision service's Container (spec 10.2), SQLite-backed; environments inherit this.
  "exports": {
    "Indexer": { "type": "durable-object", "storage": "sqlite" },
    "LiveRoom": { "type": "durable-object", "storage": "sqlite" },
    "Vision": { "type": "durable-object", "storage": "sqlite" }
  },
  "durable_objects": {
    "bindings": [
      { "name": "INDEXER", "class_name": "Indexer" },
      { "name": "LIVE_ROOMS", "class_name": "LiveRoom" },
      { "name": "VISION", "class_name": "Vision" }
    ]
  },
  // The vision service (apps/vision): PDQ and SSCD on CPU, one instance, asleep when idle. `basic` is a quarter of a vCPU
  // and 1 GiB, which the Workers Paid plan's included 25 GiB-hours a month cover if it is awake under 50 minutes a day.
  "containers": [{ "class_name": "Vision", "image": "../vision/Dockerfile", "instance_type": "basic", "max_instances": 1 }],
  // The keeper's Workflows (spec 10.2): each Instant launch's, keyed by its coin, sends the window claim at 60 s; each
  // Fair Open's, keyed by its launch account, uploads its coin's metadata, opens it at its time and pushes every seat.
  "workflows": [
    { "name": "top-pad-instant-launches", "binding": "INSTANT_LAUNCHES", "class_name": "InstantLaunchKeeper" },
    { "name": "top-pad-fair-opens", "binding": "FAIR_OPENS", "class_name": "FairOpenKeeper" },
    { "name": "top-pad-graduations", "binding": "GRADUATIONS", "class_name": "GraduationKeeper" }
  ],
  // The version this code is, which the indexer checks against the Worker's after a deploy.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  // Local development (`wrangler dev`) runs against devnet, the one cluster with Heat's configs, on the docker database.
  // The keeper and admission keys and the X app's client come in as vars from outside the repo (CLAUDE.md, "The build").
  "vars": {
    "CLUSTER": "devnet",
    // The web app's origins, comma-separated; the only ones a browser may call the API from.
    "WEB_ORIGIN": "http://localhost:3110",
    "API_ORIGIN": "http://localhost:8801",
    "KEEPER_FLOAT_MIN_LAMPORTS": "250000000"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      // The docker database (`docker compose up -d`).
      "localConnectionString": "postgres://toppad:toppad@127.0.0.1:5452/toppad"
    }
  ],
  // Signed Arweave data items wait here until uploaded, then stay as the cache (spec 10.4); simulated locally.
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "top-pad-blobs-local" }],
  // The devnet build (spec 10.4), deployed with the web Worker by `pnpm deploy:devnet` at the repo root. Bindings and
  // vars are not inherited by an environment, so everything is named again. Its secrets, set with `wrangler secret put
  // --env devnet`: RPC_URL (the Helius devnet URL, which carries the key), and optionally ALERT_WEBHOOK_URL.
  "env": {
    "devnet": {
      "name": "top-pad-api-devnet",
      "workers_dev": true,
      "triggers": { "crons": ["*/5 * * * *", "* * * * *"] },
      "vars": {
        "CLUSTER": "devnet",
        "WEB_ORIGIN": "https://top-pad-web-devnet.rc-labs.workers.dev",
        "API_ORIGIN": "https://top-pad-api-devnet.rc-labs.workers.dev",
        "KEEPER_FLOAT_MIN_LAMPORTS": "250000000",
        // X is stood in (tests/x-stand-in) until Heat has its own X app (owner, 2026-10-29); its client is no secret. The
        // real app replaces these four with the secrets X_CLIENT_ID and X_CLIENT_SECRET.
        "X_CLIENT_ID": "x-stand-in",
        "X_CLIENT_SECRET": "x-stand-in-has-no-secret",
        "X_AUTHORIZE_URL": "https://top-pad-x-stand-in-devnet.rc-labs.workers.dev/i/oauth2/authorize",
        "X_API_URL": "https://top-pad-x-stand-in-devnet.rc-labs.workers.dev",
        // Heat's own X account on the stand-in, @heat_devnet_account, whose token sends a barred creator their direct
        // message (spec 6.5): the stand-in's token for that handle, no secret. The real app replaces it with the secret
        // X_DM_TOKEN, Heat's account's user token with dm.write, which only the owner can grant.
        "X_DM_TOKEN": "standin.eyJ1c2VybmFtZSI6ImhlYXRfZGV2bmV0X2FjY291bnQifQ"
      },
      // `top-pad-devnet-mac`, in front of the devnet database on the owner's Mac through the Workers VPC service and the
      // tunnel `top-pad-devnet-db` (ops/devnet-db, spec 10.4, #102), with its query cache off: Hyperdrive never
      // invalidates a cached read on a write, and our reads must see the last write.
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "94fd2dace938401bab209dc57bd20bb8" }],
      "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "top-pad-blobs-devnet" }],
      "durable_objects": {
        "bindings": [
          { "name": "INDEXER", "class_name": "Indexer" },
          { "name": "LIVE_ROOMS", "class_name": "LiveRoom" },
          { "name": "VISION", "class_name": "Vision" }
        ]
      },
      "containers": [{ "class_name": "Vision", "image": "../vision/Dockerfile", "instance_type": "basic", "max_instances": 1 }],
      "workflows": [
        { "name": "top-pad-instant-launches-devnet", "binding": "INSTANT_LAUNCHES", "class_name": "InstantLaunchKeeper" },
        { "name": "top-pad-fair-opens-devnet", "binding": "FAIR_OPENS", "class_name": "FairOpenKeeper" },
        { "name": "top-pad-graduations-devnet", "binding": "GRADUATIONS", "class_name": "GraduationKeeper" }
      ],
      "version_metadata": { "binding": "CF_VERSION_METADATA" },
      // The keeper key, which is also the launch key, and the admission key, which signs each Fair Open deposit's
      // admission and holds no funds (spec 10.3), from the account's Secrets Store and bound to this Worker alone; put
      // there by the owner on 2026-10-29 and 2026-10-30, read only when a launch or an admission is signed.
      "secrets_store_secrets": [
        { "binding": "KEEPER_KEY", "store_id": "bbb2e2aa36724838a433d7495bbe9baf", "secret_name": "top-pad-devnet-keeper-key" },
        { "binding": "ADMISSION_KEY", "store_id": "bbb2e2aa36724838a433d7495bbe9baf", "secret_name": "top-pad-devnet-admission-key" },
        // Jupiter's API key, for the protected set's lists; made from the owner's shared key on 2026-11-02 (#52).
        { "binding": "JUPITER_API_KEY", "store_id": "bbb2e2aa36724838a433d7495bbe9baf", "secret_name": "top-pad-devnet-jupiter-key" },
        // The quote manager key, which writes each quote's QuoteSettings and holds no funds, for the band job (#89); made
        // from ~/.config/top-pad/devnet/quote-manager.json on 2026-11-06.
        { "binding": "QUOTE_MANAGER_KEY", "store_id": "bbb2e2aa36724838a433d7495bbe9baf", "secret_name": "top-pad-devnet-quote-manager-key" }
      ]
    }
  }
}
