# The project's own settings, loaded by direnv after ~/.config/env/global.env (CLAUDE.md). Names only; never commit values.

# The devnet database (Neon), for `pnpm db:migrate` and `pnpm deploy:devnet`.
DATABASE_URL=

# A Postgres server the unit tests make throwaway databases on: the docker one from `docker compose up -d`.
TEST_DATABASE_URL=postgres://toppad:toppad@127.0.0.1:5452/toppad

# The devnet RPC the devnet tests read; the public endpoint when unset (spec 10.5: free tiers only).
DEVNET_RPC_URL=
